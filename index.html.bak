<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Covenant Treasures International School | Creche to College in Ibadan</title>
<meta name="description" content="A faith-based school in Ibadan, Oyo State, teaching children from creche through to college. Raising future leaders in the tradition of godliness and excellence.">
<link rel="canonical" href="https://thecovenanttreasures.org/">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Covenant Treasures International School">
<meta property="og:title" content="Covenant Treasures International School | Creche to College in Ibadan">
<meta property="og:description" content="A faith-based school in Ibadan, Oyo State, teaching children from creche through to college. Raising future leaders in the tradition of godliness and excellence.">
<meta property="og:url" content="https://thecovenanttreasures.org/">
<meta property="og:image" content="https://thecovenanttreasures.org/assets/img/og-image.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#16264A">
<link rel="icon" href="assets/img/crest-small.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=Jost:ital,wght@0,300..600;1,400&display=swap" rel="stylesheet">
<script>document.documentElement.className = "js";</script>
<style>
/* ==========================================================================
   Covenant Treasures International School
   Design system — maroon & gold, crest-led
   ========================================================================== */

:root {
  /* Colour — navy and gold, taken from the school crest and the school's
     own printed materials. Wine is kept as an accent for the uniform ties. */
  --navy:          #16264A;
  --navy-deep:     #0D1730;
  --navy-soft:     #24386B;
  --navy-tint:     #EAEDF5;

  --gold:          #B08D2A;
  --gold-bright:   #E0BE59;
  --gold-pale:     #F3E7C4;

  --wine:          #7A1B32;
  --red:           #C8102E;   /* the ties, and the ribbon under the crest */
  --red-deep:      #9E0C24;
  --sky:           #3E6FA8;   /* the globe and summit in the crest */

  --cream:         #FAF6EE;
  --paper:         #FFFDF8;
  --ink:           #1B2135;
  --muted:         #5C6479;
  --rule:          #E2DCD0;

  /* legacy aliases so older rules keep resolving */
  --maroon:        var(--navy);
  --maroon-deep:   var(--navy-deep);
  --maroon-tint:   var(--navy-tint);

  /* Type */
  --display: "Bodoni Moda", "Didot", Georgia, serif;
  --body:    "Jost", "Avenir Next", "Segoe UI", system-ui, sans-serif;

  /* Space */
  --gutter: 1.35rem;
  --max: 1180px;
  --section-y: 4.5rem;

  --shadow: 0 18px 44px -28px rgba(13, 23, 48, 0.5);
  --shadow-lift: 0 28px 60px -30px rgba(13, 23, 48, 0.42);
}

@media (min-width: 800px) {
  :root { --gutter: 2.5rem; --section-y: 7rem; }
}

/* --------------------------------------------------------- reset + base */

*, *::before, *::after { box-sizing: border-box; }

html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--ink);
  font-family: var(--body);
  font-size: 1.0625rem;
  line-height: 1.75;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
}

img { max-width: 100%; display: block; height: auto; }

a { color: var(--maroon); text-decoration-thickness: 1px; text-underline-offset: 3px; }
a:hover { color: var(--gold); }

:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: 3px;
  border-radius: 2px;
}

.skip-link {
  position: absolute; left: -9999px; top: 0;
  background: var(--maroon); color: #fff;
  padding: 0.75rem 1.25rem; z-index: 200;
}
.skip-link:focus { left: 0; color: #fff; }

/* --------------------------------------------------------------- layout */

.wrap {
  width: 100%;
  max-width: var(--max);
  margin-inline: auto;
  padding-inline: var(--gutter);
}

.wrap--narrow { max-width: 760px; }

section { padding-block: var(--section-y); }
section.tight { padding-block: calc(var(--section-y) * 0.62); }

.band-maroon { background: var(--maroon); color: var(--paper); }
.band-maroon a { color: var(--gold-bright); }
.band-paper  { background: var(--paper); }
.band-cream  { background: var(--cream); }

/* ------------------------------------------------------------ typography */

h1, h2, h3, h4 {
  font-family: var(--display);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.01em;
  margin: 0 0 0.6em;
  color: var(--maroon-deep);
}

.band-maroon h1, .band-maroon h2,
.band-maroon h3, .band-maroon h4 { color: var(--paper); }

h1 { font-size: clamp(2.6rem, 10vw, 4.6rem); }
h2 { font-size: clamp(1.95rem, 6vw, 3rem); }
h3 { font-size: clamp(1.3rem, 3.6vw, 1.7rem); line-height: 1.2; }
h4 { font-size: 1.1rem; }

p { margin: 0 0 1.15em; max-width: 68ch; }

.lede {
  font-size: clamp(1.1rem, 2.8vw, 1.3rem);
  line-height: 1.65;
  color: var(--muted);
  max-width: 56ch;
}
.band-maroon .lede { color: rgba(255, 253, 249, 0.9); }

.section-head { margin-bottom: 2.75rem; }
.section-head p { color: var(--muted); }
.band-maroon .section-head p { color: rgba(255, 253, 249, 0.78); }

/* A gold hairline that reads as a crest divider, used sparingly */
.rule-gold {
  width: 64px; height: 3px;
  background: linear-gradient(90deg, var(--gold) 0%, var(--red) 100%);
  border: 0; margin: 0 0 1.5rem;
}
.band-maroon .rule-gold { background: var(--gold-bright); }

/* --------------------------------------------------------------- buttons */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  font-family: var(--body);
  font-size: 1rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  padding: 0.95rem 1.9rem;
  border-radius: 2px;
  border: 1.5px solid transparent;
  text-decoration: none;
  cursor: pointer;
  transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease;
}

.btn--primary { background: var(--red); color: var(--paper); border-color: var(--red); }
.btn--primary:hover { background: var(--red-deep); border-color: var(--red-deep); color: var(--paper); }

.btn--ghost { background: transparent; color: var(--maroon); border-color: var(--maroon); }
.btn--ghost:hover { background: var(--maroon); color: var(--paper); }

.btn--gold { background: var(--gold-bright); color: #2A2005; border-color: var(--gold-bright); font-weight: 600; }
.btn--gold:hover { background: var(--gold-pale); color: #2A2005; border-color: var(--gold-pale); }

.btn--onmaroon { background: transparent; color: var(--paper); border-color: rgba(255,253,249,0.5); }
.btn--onmaroon:hover { background: var(--paper); color: var(--maroon); border-color: var(--paper); }

.btn-row { display: flex; flex-wrap: wrap; gap: 0.85rem; }
.btn-row .btn { flex: 1 1 auto; min-width: 200px; }
@media (min-width: 620px) { .btn-row .btn { flex: 0 0 auto; } }

/* ---------------------------------------------------------------- header */

.topbar {
  background: var(--maroon-deep);
  color: rgba(255, 253, 249, 0.9);
  font-size: 0.82rem;
  letter-spacing: 0.02em;
}
.topbar .wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: 38px;
}
.topbar a { color: rgba(255, 253, 249, 0.9); text-decoration: none; }
.topbar a:hover { color: var(--gold-bright); }
.topbar-links { display: flex; gap: 1.35rem; min-width: 0; }
.topbar-links a { white-space: nowrap; }
.topbar-socials { display: flex; gap: 0.9rem; flex: 0 0 auto; }
.topbar-socials svg { width: 15px; height: 15px; fill: currentColor; display: block; }
@media (max-width: 720px) {
  .topbar { font-size: 0.78rem; }
  .topbar-links { gap: 0.9rem; }
  .topbar-links .label { display: none; }
  .topbar-links a {
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
  }
}
@media (max-width: 400px) {
  .topbar { font-size: 0.72rem; }
  .topbar-socials { gap: 0.7rem; }
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--paper);
  border-bottom: 1px solid var(--rule);
}
.site-header .wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  min-height: 74px;
}

.brand { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; flex: 0 1 auto; min-width: 0; }
.brand img { width: 44px; height: 44px; object-fit: contain; }
.brand-text { display: flex; flex-direction: column; line-height: 1; }
.brand-name {
  font-family: var(--display);
  font-weight: 600;
  font-size: 1.02rem;
  letter-spacing: 0.02em;
  color: var(--maroon-deep);
  text-transform: uppercase;
}
.brand-sub {
  font-size: 0.63rem;
  letter-spacing: 0.19em;
  color: var(--gold);
  text-transform: uppercase;
  margin-top: 5px;
}
@media (min-width: 500px) {
  .brand img { width: 52px; height: 52px; }
  .brand-name { font-size: 1.2rem; }
}


/* nav */
.nav-toggle {
  display: inline-flex; align-items: center; gap: 0.55rem;
  background: transparent; border: 1.5px solid var(--maroon);
  color: var(--maroon); font-family: var(--body); font-size: 0.95rem;
  padding: 0.5rem 1rem; border-radius: 2px; cursor: pointer;
}
.nav-toggle .bars { display: block; width: 17px; height: 10px; position: relative; }
.nav-toggle .bars::before,
.nav-toggle .bars::after {
  content: ""; position: absolute; left: 0; right: 0; height: 1.5px; background: currentColor;
}
.nav-toggle .bars::before { top: 0; }
.nav-toggle .bars::after { bottom: 0; }

.site-nav ul {
  list-style: none; margin: 0; padding: 0;
}
.site-nav a {
  display: block;
  text-decoration: none;
  color: var(--ink);
  font-size: 0.98rem;
  letter-spacing: 0.03em;
  padding: 0.85rem 0;
  border-bottom: 1px solid var(--rule);
}
.site-nav a:hover, .site-nav a[aria-current="page"] { color: var(--maroon); }
.site-nav a.btn--primary { color: var(--paper); }
.site-nav a.btn { display: flex; justify-content: center; }
.site-nav a.btn--primary:hover { color: var(--paper); }

@media (max-width: 1079px) {
  .site-nav {
    display: none;
    position: absolute; left: 0; right: 0; top: 100%;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    box-shadow: var(--shadow);
    padding: 0.5rem var(--gutter) 1.75rem;
  }
  .site-nav.open { display: block; }
  .site-nav .btn { width: 100%; margin-top: 1.1rem; }
}

@media (min-width: 1080px) {
  .nav-toggle { display: none; }
  .site-nav {
    display: flex !important;
    align-items: center;
    gap: 1.6rem;
    flex: 0 0 auto;
  }
  .site-nav ul { display: flex; align-items: center; gap: 1.6rem; }
  .site-nav a { padding: 0; border-bottom: 0; font-size: 0.92rem; white-space: nowrap; }
  .site-nav a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--red); }
  .site-nav .btn {
    flex: 0 0 auto;
    width: auto;
    padding: 0.7rem 1.35rem;
    font-size: 0.92rem;
  }
  .site-nav .btn:hover { box-shadow: none; }
}
@media (min-width: 1080px) and (max-width: 1280px) {
  .site-nav, .site-nav ul { gap: 1.05rem; }
  .site-nav a { font-size: 0.85rem; }
  .site-nav .btn { padding: 0.65rem 1.1rem; font-size: 0.85rem; }
  .brand img { width: 42px; height: 42px; }
  .brand-name { font-size: 1rem; }
}

/* ------------------------------------------------------------------ hero */

.hero {
  position: relative;
  background: var(--navy-deep);
  color: var(--paper);
  overflow: hidden;
  padding-block: clamp(4rem, 13vw, 8.5rem);
}

/* the photograph sits behind everything, dimmed by a navy wash so the
   headline keeps its contrast at every viewport width */
.hero-photo {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center 38%;
  opacity: 0.42;
  z-index: 0;
}
.hero::before {
  content: "";
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(100deg,
    rgba(13, 23, 48, 0.94) 0%,
    rgba(13, 23, 48, 0.86) 42%,
    rgba(13, 23, 48, 0.55) 72%,
    rgba(13, 23, 48, 0.4) 100%);
}
.hero::after {
  content: "";
  position: absolute; left: 0; right: 0; bottom: 0; height: 5px; z-index: 2;
  background: linear-gradient(90deg, var(--gold) 0%, var(--gold-bright) 45%, var(--red) 100%);
}

/* On a narrow screen the angled wash covers the whole photo, so switch to a
   vertical one and let the picture read below the text. */
@media (max-width: 780px) {
  .hero { padding-bottom: 3rem; }
  .hero-photo { opacity: 0.5; background-position: center 30%; }
  .hero::before {
    background: linear-gradient(180deg,
      rgba(13, 23, 48, 0.95) 0%,
      rgba(13, 23, 48, 0.9) 55%,
      rgba(13, 23, 48, 0.62) 100%);
  }
  .hero-eyebrow::before { display: none; }
  .hero-eyebrow { letter-spacing: 0.16em; margin-bottom: 1rem; }
}
.hero .wrap { position: relative; z-index: 3; }

.hero-eyebrow {
  display: inline-flex; align-items: center; gap: 0.7rem;
  font-size: 0.78rem; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--gold-bright);
  margin-bottom: 1.4rem;
}
.hero-eyebrow::before {
  content: ""; width: 32px; height: 1px; background: var(--gold);
}

.hero h1 {
  color: var(--paper);
  margin-bottom: 1.1rem;
  max-width: 13ch;
  text-shadow: 0 2px 24px rgba(13, 23, 48, 0.5);
}
.hero h1 em {
  font-style: italic;
  font-weight: 400;
  color: var(--gold-bright);
  display: block;
}
.hero .lede { margin-bottom: 2.2rem; max-width: 46ch; color: rgba(255, 253, 248, 0.92); }
.hero-meta {
  margin-top: 2.6rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(255, 253, 248, 0.25);
  font-size: 0.92rem;
  color: rgba(255, 253, 248, 0.8);
  max-width: 46ch;
}

.hero-crest { display: none; }

/* page banner (interior pages) */
.page-head {
  position: relative;
  background: var(--navy);
  color: var(--paper);
  padding-block: clamp(2.75rem, 8vw, 4.75rem);
  overflow: hidden;
}
.page-head::after {
  content: "";
  position: absolute; left: 0; right: 0; bottom: 0; height: 4px;
  background: linear-gradient(90deg, var(--gold) 0%, var(--gold-bright) 50%, var(--wine) 100%);
}
.page-head h1 { color: var(--paper); font-size: clamp(2.1rem, 7.5vw, 3.4rem); margin-bottom: 0.5rem; }
.page-head p { color: rgba(255, 253, 249, 0.8); max-width: 54ch; margin: 0; }

/* ---------------------------------------------------- the four quarters */
/* Mirrors the four quarters of the school crest: cross, summit, lyre, globe */

.quarters {
  display: grid;
  gap: 1px;
  background: var(--rule);
  border: 1px solid var(--rule);
}
@media (min-width: 700px) { .quarters { grid-template-columns: 1fr 1fr; } }

.quarter {
  background: var(--paper);
  padding: 2.2rem 1.7rem 2.4rem;
  transition: background-color 0.25s ease;
}
.quarter:hover { background: var(--gold-pale); }
.quarter .mark {
  width: 54px; height: 54px; margin-bottom: 1.2rem;
  display: grid; place-items: center;
  background: var(--navy-tint);
  border-radius: 50%;
  padding: 12px;
}
.quarter .mark svg { width: 100%; height: 100%; display: block; }
.quarter h3 { margin-bottom: 0.5rem; }
.quarter p { color: var(--muted); margin: 0; font-size: 0.98rem; }

/* --------------------------------------------------------- the continuum */
/* Creche -> Basic -> College is a genuine progression, so it is numbered */

.continuum { display: grid; gap: 1.15rem; }
@media (min-width: 860px) { .continuum { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }

.stage {
  position: relative;
  background: var(--paper);
  border: 1px solid var(--rule);
  border-top: 3px solid var(--gold);
  display: flex; flex-direction: column;
  overflow: hidden;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.stage:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
.stage-photo {
  height: 190px;
  background-size: cover;
  background-position: center 34%;
  border-bottom: 1px solid var(--rule);
}
.stage-body { padding: 1.8rem 1.6rem 2rem; display: flex; flex-direction: column; flex: 1; }
.stage-body .step {
  font-family: var(--display);
  font-style: italic;
  font-size: 1.05rem;
  color: var(--gold);
  margin-bottom: 0.9rem;
}
.stage-body .ages {
  font-size: 0.85rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 1rem;
}
.stage-body p { font-size: 0.98rem; color: var(--muted); flex: 1; }
.stage-body .more {
  margin-top: 1.1rem; font-size: 0.95rem; font-weight: 500;
  text-decoration: none; color: var(--navy);
  border-bottom: 1px solid var(--red); align-self: flex-start;
  padding-bottom: 2px;
}
.stage-body .more:hover { color: var(--gold); }

/* ------------------------------------------------------------- facts row */

.facts { display: grid; gap: 1px; background: rgba(255,253,249,0.2); }
@media (min-width: 560px) { .facts { grid-template-columns: 1fr 1fr; } }
@media (min-width: 900px) { .facts { grid-template-columns: repeat(4, 1fr); } }

.fact { background: var(--navy); padding: 2.1rem 1.4rem; text-align: center; }
.fact .n {
  font-family: var(--display);
  font-size: clamp(2.1rem, 6vw, 2.9rem);
  line-height: 1;
  color: var(--gold-bright);
  display: block;
  margin-bottom: 0.5rem;
}
.fact .l { font-size: 0.9rem; color: rgba(255,253,249,0.82); letter-spacing: 0.03em; }

/* ---------------------------------------------------------------- cards */

.grid { display: grid; gap: 1.35rem; }
@media (min-width: 700px) { .grid--2 { grid-template-columns: 1fr 1fr; } }
@media (min-width: 760px) { .grid--3 { grid-template-columns: repeat(3, 1fr); } }

.card {
  background: var(--paper);
  border: 1px solid var(--rule);
  padding: 1.75rem 1.5rem;
}
.card h3 { font-size: 1.25rem; }
.card p { color: var(--muted); font-size: 0.98rem; margin-bottom: 0; }
.card .meta {
  font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 0.7rem;
}

/* split feature */
.split { display: grid; gap: 2.5rem; align-items: center; }
@media (min-width: 880px) { .split { grid-template-columns: 1fr 1fr; gap: 4rem; } }
.split .figure {
  background: var(--paper);
  border: 1px solid var(--rule);
  aspect-ratio: 4 / 3;
  display: grid; place-items: center;
  padding: 2rem;
}
.split .figure img { max-height: 100%; width: auto; }

/* photo variant: fills the frame instead of sitting inside it */
.split .figure--photo { padding: 0; border: 0; overflow: hidden; }
.campus-photo {
  background-size: cover;
  background-position: center 62%;
  background-repeat: no-repeat;
  aspect-ratio: 3 / 2;
  width: 100%;
}

/* ------------------------------------------------------------- list bits */

.ticks { list-style: none; margin: 0 0 1.5rem; padding: 0; }
.ticks li {
  position: relative;
  padding-left: 1.7rem;
  margin-bottom: 0.75rem;
  color: var(--muted);
}
.ticks li::before {
  content: "";
  position: absolute; left: 0; top: 0.72em;
  width: 9px; height: 9px;
  background: var(--gold);
  transform: rotate(45deg);
}
.band-maroon .ticks li { color: rgba(255,253,249,0.85); }

/* numbered process */
.steps { list-style: none; counter-reset: s; margin: 0; padding: 0; }
.steps li {
  counter-increment: s;
  position: relative;
  padding-left: 3.5rem;
  padding-bottom: 2rem;
  border-left: 1px solid var(--rule);
  margin-left: 1.1rem;
}
.steps li:last-child { border-left-color: transparent; padding-bottom: 0; }
.steps li::before {
  content: counter(s);
  position: absolute; left: -1.1rem; top: 0;
  width: 2.2rem; height: 2.2rem;
  background: var(--maroon); color: var(--paper);
  font-family: var(--display); font-size: 0.95rem;
  display: grid; place-items: center;
  border-radius: 50%;
}
.steps h3 { font-size: 1.2rem; margin-bottom: 0.35rem; }
.steps p { color: var(--muted); font-size: 0.98rem; margin-bottom: 0; }

/* -------------------------------------------------------------- accordion */

.acc { border-top: 1px solid var(--rule); }
.acc-item { border-bottom: 1px solid var(--rule); }
.acc-btn {
  width: 100%; text-align: left;
  background: none; border: 0;
  font-family: var(--display); font-size: 1.1rem; font-weight: 600;
  color: var(--maroon-deep);
  padding: 1.25rem 2.5rem 1.25rem 0;
  cursor: pointer; position: relative;
}
.acc-btn::after {
  content: "+";
  position: absolute; right: 0.25rem; top: 50%;
  transform: translateY(-50%);
  font-family: var(--body); font-size: 1.5rem; color: var(--gold);
  line-height: 1;
}
.acc-btn[aria-expanded="true"]::after { content: "\2212"; }
.acc-panel { display: none; padding-bottom: 1.4rem; }
.acc-panel p { color: var(--muted); margin-bottom: 0; }
.acc-btn[aria-expanded="true"] + .acc-panel { display: block; }

/* ------------------------------------------------------------------ form */

.form { display: grid; gap: 1.15rem; }
@media (min-width: 700px) { .form .two { display: grid; grid-template-columns: 1fr 1fr; gap: 1.15rem; } }

.field label {
  display: block;
  font-size: 0.86rem;
  letter-spacing: 0.06em;
  color: var(--maroon-deep);
  margin-bottom: 0.4rem;
  font-weight: 500;
}
.field input, .field select, .field textarea {
  width: 100%;
  font-family: var(--body); font-size: 1rem;
  color: var(--ink);
  background: var(--paper);
  border: 1px solid var(--rule);
  border-radius: 2px;
  padding: 0.8rem 0.9rem;
}
.field textarea { min-height: 130px; resize: vertical; }
.field input:focus, .field select:focus, .field textarea:focus { border-color: var(--gold); }
.field .hint { font-size: 0.84rem; color: var(--muted); margin-top: 0.35rem; }

.form-note {
  background: var(--maroon-tint);
  border-left: 3px solid var(--gold);
  padding: 1rem 1.2rem;
  font-size: 0.94rem;
  color: var(--maroon-deep);
}

/* ---------------------------------------------------------------- gallery */

/* Masonry via CSS columns: the photos are a mix of portrait and landscape,
   and cropping them to a uniform cell cuts through people's faces. */
.gallery { columns: 2; column-gap: 0.85rem; }
@media (min-width: 780px) { .gallery { columns: 3; column-gap: 1.15rem; } }

.gallery figure {
  margin: 0 0 0.85rem;
  break-inside: avoid;
  -webkit-column-break-inside: avoid;
  background: var(--maroon-tint);
  border: 1px solid var(--rule);
  overflow: hidden;
  color: var(--muted); font-size: 0.85rem; text-align: center;
}
@media (min-width: 780px) { .gallery figure { margin-bottom: 1.15rem; } }

.gallery figure img { width: 100%; height: auto; display: block; }

.gallery-filters { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2rem; }
.gallery-filters button {
  font-family: var(--body); font-size: 0.9rem;
  background: transparent; border: 1px solid var(--rule);
  color: var(--muted); padding: 0.5rem 1.1rem; border-radius: 2px; cursor: pointer;
}
.gallery-filters button[aria-pressed="true"] {
  background: var(--maroon); border-color: var(--maroon); color: var(--paper);
}

.gallery figure:has(img) { cursor: zoom-in; padding: 0; }
.gallery figure img { transition: transform 0.4s ease; }
.gallery figure:hover img { transform: scale(1.04); }

/* ------------------------------------------------------------- lightbox */
.lb {
  position: fixed; inset: 0; z-index: 200;
  background: rgba(30, 8, 18, 0.94);
  display: none; align-items: center; justify-content: center;
  padding: 1rem;
}
.lb.open { display: flex; }
.lb img { max-width: 100%; max-height: 86vh; object-fit: contain; }
.lb figcaption {
  position: absolute; left: 0; right: 0; bottom: 1.5rem;
  text-align: center; color: rgba(255,253,249,0.85);
  font-size: 0.9rem; padding-inline: 4rem;
}
.lb button {
  position: absolute; background: transparent; cursor: pointer;
  border: 1px solid rgba(255,253,249,0.4); color: var(--paper);
  width: 46px; height: 46px; border-radius: 50%;
  font-size: 1.4rem; line-height: 1; display: grid; place-items: center;
}
.lb button:hover { background: rgba(255,253,249,0.14); }
.lb .lb-close { top: 1rem; right: 1rem; }
.lb .lb-prev { left: 1rem; }
.lb .lb-next { right: 1rem; }
@media (max-width: 560px) {
  .lb .lb-prev { left: 0.5rem; }
  .lb .lb-next { right: 0.5rem; }
  .lb figcaption { padding-inline: 1rem; bottom: 0.75rem; }
}

/* ------------------------------------------------------- news lead story */

.lead-story { display: grid; gap: 2rem; align-items: center; }
@media (min-width: 900px) {
  .lead-story { grid-template-columns: 1.15fr 1fr; gap: 3.5rem; }
}
.lead-media { border: 1px solid var(--rule); overflow: hidden; background: var(--maroon-tint); }
.lead-media img { width: 100%; height: auto; display: block; }
.lead-body h2 { font-size: clamp(1.7rem, 4.5vw, 2.4rem); }
.lead-body .meta {
  font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--gold); margin-bottom: 0.7rem;
}
.lead-body p { color: var(--muted); }
.lead-body h2 + p { color: var(--ink); font-size: 1.08rem; }

/* cards that carry an image */
.card--media { padding: 0; display: flex; flex-direction: column; overflow: hidden; }
.card--media img { width: 100%; height: 190px; object-fit: cover; display: block; }
.card .card-body { padding: 1.6rem 1.5rem; }

/* staff portraits are 4:5 and want more height than a news thumbnail */
.card--media.staff img { height: 320px; object-position: center 22%; border-bottom-color: var(--gold); }
.card--media.staff .meta { color: var(--red); }
.card--media .card-body { flex: 1; }

/* ------------------------------------------------------------------- CTA */

.cta-band {
  position: relative;
  background: var(--navy-deep); color: var(--paper); text-align: center;
  overflow: hidden;
}
.cta-band::before {
  content: "";
  position: absolute; left: 0; right: 0; top: 0; height: 4px;
  background: linear-gradient(90deg, var(--wine) 0%, var(--gold-bright) 55%, var(--gold) 100%);
}
.cta-band h2 { color: var(--paper); }
.cta-band p { margin-inline: auto; color: rgba(255,253,249,0.82); }
.cta-band .btn-row { justify-content: center; }

/* ---------------------------------------------------------------- footer */

.site-footer { background: var(--maroon); color: rgba(255,253,249,0.82); padding-block: 3.5rem 2rem; }
.site-footer a { color: rgba(255,253,249,0.82); text-decoration: none; }
.site-footer a:hover { color: var(--gold-bright); }
.footer-grid { display: grid; gap: 2.5rem; }
@media (min-width: 760px) { .footer-grid { grid-template-columns: 1.4fr 1fr 1.3fr; gap: 3rem; } }
.footer-grid h4 {
  color: var(--gold-bright);
  font-family: var(--body);
  font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase;
  font-weight: 500; margin-bottom: 1.1rem;
}
.footer-grid ul { list-style: none; margin: 0; padding: 0; }
.footer-grid li { margin-bottom: 0.6rem; }
.footer-brand p { font-family: var(--display); font-size: 1.1rem; line-height: 1.5; color: var(--paper); max-width: 30ch; }
.footer-socials { display: flex; gap: 1rem; margin-top: 1.25rem; }
.footer-socials a { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid rgba(255,253,249,0.3); }
.footer-socials svg { width: 16px; height: 16px; fill: currentColor; }
.footer-grid a.with-icon { display: inline-flex; align-items: center; gap: 0.5rem; }
.footer-grid a.with-icon svg { width: 15px; height: 15px; fill: var(--gold-bright); flex: 0 0 auto; }
.footer-base {
  margin-top: 3rem; padding-top: 1.5rem;
  border-top: 1px solid rgba(255,253,249,0.18);
  font-size: 0.86rem;
  display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between;
}

/* -------------------------------------------------------- whatsapp float */

.wa {
  position: fixed; right: 1rem; bottom: 1rem; z-index: 90;
  display: inline-flex; align-items: center; gap: 0.55rem;
  background: #128C7E; color: #fff;
  padding: 0.75rem 1.1rem; border-radius: 999px;
  text-decoration: none; font-size: 0.92rem; font-weight: 500;
  box-shadow: 0 10px 26px -12px rgba(0,0,0,0.5);
}
.wa:hover { background: #0F7A6D; color: #fff; }
.wa svg { width: 19px; height: 19px; fill: currentColor; }
@media (max-width: 480px) { .wa .label { display: none; } .wa { padding: 0.85rem; } }

/* --------------------------------------------------------- one entrance */
/* A single orchestrated page-load reveal on the hero only. */

@media (prefers-reduced-motion: no-preference) {
  .hero h1, .hero .lede, .hero .btn-row, .hero-meta {
    opacity: 0;
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.3, 1) forwards;
  }
  .hero h1      { animation-delay: 0.05s; }
  .hero .lede   { animation-delay: 0.18s; }
  .hero .btn-row{ animation-delay: 0.30s; }
  .hero-meta    { animation-delay: 0.42s; }
}

@keyframes rise {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: none; }
}

.visually-hidden {
  position: absolute; width: 1px; height: 1px;
  padding: 0; margin: -1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}


/* =========================================================================
   Announcement bar
   ========================================================================= */

.announce {
  background: linear-gradient(90deg, var(--gold) 0%, var(--gold-bright) 50%, var(--gold) 100%);
  color: #241A05;
  font-size: 0.88rem;
  text-align: center;
}
.announce .wrap {
  display: flex; align-items: center; justify-content: center;
  gap: 0.9rem; flex-wrap: wrap;
  padding-block: 0.6rem;
}
.announce strong { font-weight: 600; }
.announce a {
  color: var(--navy-deep); font-weight: 600;
  text-decoration: none;
  border-bottom: 1.5px solid rgba(13,23,48,0.4);
  white-space: nowrap;
}
.announce a:hover { border-bottom-color: var(--navy-deep); color: var(--navy-deep); }
@media (max-width: 560px) { .announce { font-size: 0.8rem; } }

/* =========================================================================
   Full-bleed photographic band
   ========================================================================= */

.band-photo {
  position: relative;
  color: var(--paper);
  overflow: hidden;
  padding-block: clamp(4.5rem, 12vw, 8rem);
  text-align: center;
}
.band-photo .bg {
  position: absolute; inset: 0;
  background-size: cover; background-position: center 40%;
  z-index: 0;
}
.band-photo::before {
  content: "";
  position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(180deg,
    rgba(13,23,48,0.9) 0%, rgba(13,23,48,0.78) 50%, rgba(13,23,48,0.9) 100%);
}
.band-photo .wrap { position: relative; z-index: 2; }
.band-photo h2 { color: var(--paper); }
.band-photo .statement {
  font-family: var(--display);
  font-size: clamp(1.6rem, 4.6vw, 2.9rem);
  line-height: 1.28;
  max-width: 20ch;
  margin: 0 auto 1.5rem;
  color: var(--paper);
}
.band-photo .statement em { font-style: italic; color: var(--gold-bright); }
.band-photo .attrib {
  font-size: 0.9rem; letter-spacing: 0.14em; text-transform: uppercase;
  color: rgba(255,253,248,0.72);
}

/* =========================================================================
   Values framework
   ========================================================================= */

.values { display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); }
@media (min-width: 620px) { .values { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 940px) { .values { grid-template-columns: repeat(3, 1fr); } }

.value {
  background: var(--paper);
  padding: 2.1rem 1.7rem 2.3rem;
  position: relative;
  transition: background-color 0.25s ease;
}
.value:hover { background: var(--navy-tint); }
.value .num {
  font-family: var(--display); font-style: italic;
  font-size: 1.5rem; color: var(--gold);
  display: block; margin-bottom: 0.7rem;
}
.value h3 { font-size: 1.22rem; margin-bottom: 0.45rem; }
.value p { color: var(--muted); font-size: 0.97rem; margin: 0; }
.value::after {
  content: ""; position: absolute; left: 0; top: 0; width: 3px; height: 0;
  background: var(--red); transition: height 0.3s ease;
}
.value:hover::after { height: 100%; }

/* =========================================================================
   School anthem
   ========================================================================= */

.anthem {
  background: var(--navy);
  color: var(--paper);
  border-left: 4px solid var(--gold);
  padding: 2.5rem 2rem;
}
.anthem h3 { color: var(--gold-bright); font-size: 1.05rem;
  font-family: var(--body); letter-spacing: 0.16em; text-transform: uppercase;
  font-weight: 500; margin-bottom: 1.5rem; }
.anthem p {
  font-family: var(--display);
  font-size: clamp(1.05rem, 2.4vw, 1.25rem);
  line-height: 1.75;
  color: rgba(255,253,248,0.94);
  max-width: 40ch;
}
.anthem p + p { margin-top: 1.3rem; }

/* =========================================================================
   Scroll reveal
   ========================================================================= */

@media (prefers-reduced-motion: no-preference) {
  .reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.7s cubic-bezier(0.2,0.7,0.3,1),
                transform 0.7s cubic-bezier(0.2,0.7,0.3,1);
  }
  .reveal.shown { opacity: 1; transform: none; }
  .reveal-stagger > * { transition-delay: var(--d, 0ms); }
}

/* red as a deliberate accent, not a wash */
.card--media img { border-bottom: 3px solid var(--red); }
.lead-media { border-bottom: 3px solid var(--gold); }
.fact { border-top: 2px solid transparent; transition: border-color 0.25s ease; }
.fact:hover { border-top-color: var(--gold-bright); }

/* =========================================================================
   Mobile refinements
   Most visitors arrive on a phone, so the small screen gets its own pass
   rather than inheriting whatever the desktop layout leaves behind.
   ========================================================================= */

@media (max-width: 700px) {

  /* Tighter vertical rhythm — the desktop spacing reads as dead air here */
  :root { --section-y: 3.4rem; --gutter: 1.25rem; }

  body { line-height: 1.65; }

  /* The header stack (announce + contact + logo) was eating 15% of the
     screen before any content appeared. */
  .announce .wrap { padding-block: 0.5rem; gap: 0.5rem; }
  .topbar .wrap { min-height: 32px; }
  .site-header .wrap { min-height: 60px; gap: 0.75rem; }

  .brand img { width: 38px; height: 38px; }
  .brand-name { font-size: 0.94rem; letter-spacing: 0.01em; white-space: nowrap; }
  .brand-sub { font-size: 0.55rem; letter-spacing: 0.14em; margin-top: 3px; white-space: nowrap; }

  .nav-toggle { padding: 0.42rem 0.8rem; font-size: 0.88rem; }

  /* Headings carry more weight when they are tighter on a narrow measure */
  h1 { letter-spacing: -0.02em; }
  h2 { letter-spacing: -0.015em; line-height: 1.08; }
  .section-head { margin-bottom: 1.9rem; }

  /* Cards: less inner padding, so more of the screen is content */
  .quarter { padding: 1.6rem 1.3rem 1.75rem; }
  .quarter .mark { width: 44px; height: 44px; padding: 10px; margin-bottom: 0.9rem; }
  .card .card-body, .card { padding: 1.4rem 1.25rem; }
  .value { padding: 1.6rem 1.3rem 1.75rem; }
  .stage-body { padding: 1.4rem 1.3rem 1.6rem; }
  .stage-photo { height: 170px; }
  .anthem { padding: 1.9rem 1.4rem; }

  /* The decorative crest panel is pure ornament — on a phone it costs a
     screen of scrolling and gives nothing back, so it goes. */
  .split .figure:not(.figure--photo) { display: none; }

  /* Statement type in the photo bands was close to the edges */
  .band-photo .statement { max-width: 16ch; }
  .band-photo { padding-block: 3.6rem; }

  /* Steps list: reclaim the left indent */
  .steps li { padding-left: 2.9rem; padding-bottom: 1.6rem; }

  /* Float button was sitting on top of body copy */
  .wa { right: 0.85rem; bottom: 0.85rem; box-shadow: 0 6px 20px -8px rgba(0,0,0,0.55); }

  /* Gallery: a little more air between the columns */
  .gallery { column-gap: 0.7rem; }
  .gallery figure { margin-bottom: 0.7rem; }

  /* Buttons already stack full-width; make them a touch shorter */
  .btn { padding: 0.85rem 1.5rem; }
}

@media (max-width: 400px) {
  .brand-name { font-size: 0.86rem; }
  .brand img { width: 34px; height: 34px; }
}


/* ------------------------------------------------ crest, embedded once */
.crest-art {
  background-image: url(assets/img/crest.png);
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  width: 100%;
  aspect-ratio: 1;
  max-width: 340px;
  margin-inline: auto;
}
.hero-photo { background-image: url(assets/img/gallery/resumption-day-assembly.webp); }
.band-photo .bg.bg--basic { background-image: url(assets/img/gallery/basic-school-group.webp); }
.band-photo .bg.bg--college { background-image: url(assets/img/gallery/college-students-group.webp); background-position: center 30%; }

/* .split .figure sets a `background` shorthand, which outranks a bare
   .campus-photo rule and blanks the image — hence the extra specificity. */
.split .figure.campus-photo {
  background-image: url(assets/img/campus.webp);
  background-size: cover;
  background-position: center 62%;
  background-repeat: no-repeat;
  aspect-ratio: 3 / 2;
}

.hero-crest.crest-art {
  width: min(380px, 30vw);
  max-width: none;
  margin: 0;
}

/* .page is a <section>, so it would inherit the global section padding */
.page { padding-block: 0; }

/* the sticky header would otherwise cover whatever we scroll to */
.page, .page [id] { scroll-margin-top: 96px; }

/* ---------------------------------------------------- single-file router */
/* Without JavaScript every page is simply stacked and readable. */
.js .page { display: none; }
.js .page.is-active { display: block; }
.no-js .page + .page { border-top: 6px solid var(--gold); }

</style>
