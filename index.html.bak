          <li><a href="#admissions">Admissions</a></li>
          <li><a href="#campus-life">Campus life</a></li>
          <li><a href="#news">News &amp; events</a></li>
          <li><a href="#gallery">Gallery</a></li>
        </ul>
      </div>

      <div>
        <h4>Visit us</h4>
        <p>Zone 3, Lane 2, Olose (Unity Estate), Off Akala Express Way, Kuola, Ibadan, Oyo State</p>
        <ul>
          <li><a class="with-icon" href="tel:+2349123043411"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1.1l-2.3 2.1z"/></svg><span>+234 912 304 3411</span></a></li>
          <li><a href="mailto:info@thecovenanttreasures.org">info@thecovenanttreasures.org</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-base">
      <span>&copy; <span id="year">2026</span> Covenant Treasures International School. All rights reserved.</span>
      <span>Creche &middot; Basic School &middot; College</span>
    </div>
  </div>
</footer>

<a class="wa" href="https://wa.me/2349123043411?text=Hello%20Covenant%20Treasures%2C%20I%27d%20like%20to%20ask%20about%20admissions."
   target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.04 2A9.9 9.9 0 0 0 2.1 11.9a9.8 9.8 0 0 0 1.35 4.96L2 22l5.28-1.38a9.9 9.9 0 0 0 4.76 1.21h.01a9.9 9.9 0 0 0 9.94-9.9A9.9 9.9 0 0 0 12.04 2zm5.8 14.06c-.24.68-1.42 1.3-1.96 1.35-.5.05-.98.23-3.3-.69-2.78-1.09-4.54-3.94-4.68-4.12-.13-.18-1.11-1.48-1.11-2.82 0-1.34.7-2 .95-2.27.25-.27.54-.34.72-.34l.52.01c.17 0 .39-.06.61.47.23.55.78 1.9.85 2.04.07.14.11.3.02.48-.09.18-.14.3-.27.46l-.4.47c-.13.14-.27.29-.12.56.15.27.67 1.1 1.43 1.79.98.87 1.81 1.14 2.08 1.27.27.14.42.11.58-.07.16-.18.67-.78.85-1.05.18-.27.36-.22.6-.13.25.09 1.58.75 1.85.88.27.14.45.2.52.32.07.11.07.65-.17 1.32z"/></svg><span class="label">WhatsApp us</span>
</a>

<script>
(function () {
  "use strict";


  var WHATSAPP = "2349123043411";

  /* ---------------------------------------------------------- mobile nav */
  var toggle = document.querySelector(".nav-toggle");
  var nav = document.getElementById("site-nav");

  if (toggle && nav) {
    toggle.addEventListener("click", function () {
      var open = nav.classList.toggle("open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.querySelector(".nav-toggle-label").textContent = open ? "Close" : "Menu";
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && nav.classList.contains("open")) {
        nav.classList.remove("open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.querySelector(".nav-toggle-label").textContent = "Menu";
        toggle.focus();
      }
    });
  }

  /* ----------------------------------------------------------- accordion */
  document.querySelectorAll(".acc-btn").forEach(function (btn) {
    btn.addEventListener("click", function () {
      var open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", open ? "false" : "true");
    });
  });

  /* ----------------------------------------------------- gallery filters */
  var filters = document.querySelectorAll(".gallery-filters button");
  if (filters.length) {
    filters.forEach(function (btn) {
      btn.addEventListener("click", function () {
        var want = btn.dataset.filter;
        filters.forEach(function (b) {
          b.setAttribute("aria-pressed", b === btn ? "true" : "false");
        });
        document.querySelectorAll(".gallery figure").forEach(function (fig) {
          var show = want === "all" || fig.dataset.cat === want;
          fig.hidden = !show;
        });
      });
    });
  }

  /* --------------------------------------------------------- lightbox */
  var galleryFigures = Array.prototype.slice.call(
    document.querySelectorAll(".gallery figure img")
  );

  if (galleryFigures.length) {
    var lb = document.createElement("div");
    lb.className = "lb";
    lb.setAttribute("role", "dialog");
    lb.setAttribute("aria-modal", "true");
    lb.setAttribute("aria-label", "Photo viewer");
    lb.innerHTML =
      '<button class="lb-close" type="button" aria-label="Close">&times;</button>' +
      '<button class="lb-prev" type="button" aria-label="Previous photo">&#8249;</button>' +
      '<button class="lb-next" type="button" aria-label="Next photo">&#8250;</button>' +
      '<figure style="margin:0"><img alt=""><figcaption></figcaption></figure>';
    document.body.appendChild(lb);

    var lbImg = lb.querySelector("img");
    var lbCap = lb.querySelector("figcaption");
    var index = 0;
    var lastFocus = null;

    function visible() {
      return galleryFigures.filter(function (img) {
        return !img.closest("figure").hidden;
      });
    }

    function render() {
      var list = visible();
      if (!list.length) return;
      index = (index + list.length) % list.length;
      lbImg.src = list[index].src;
      lbImg.alt = list[index].alt || "";
      lbCap.textContent = list[index].alt || "";
    }

    function open(img) {
      lastFocus = document.activeElement;
      index = visible().indexOf(img);
      render();
      lb.classList.add("open");
      document.body.style.overflow = "hidden";
      lb.querySelector(".lb-close").focus();
    }

    function close() {
      lb.classList.remove("open");
      document.body.style.overflow = "";
      if (lastFocus) lastFocus.focus();
    }

    galleryFigures.forEach(function (img) {
      img.closest("figure").addEventListener("click", function () { open(img); });
    });

    lb.querySelector(".lb-close").addEventListener("click", close);
    lb.querySelector(".lb-prev").addEventListener("click", function () { index--; render(); });
    lb.querySelector(".lb-next").addEventListener("click", function () { index++; render(); });
    lb.addEventListener("click", function (e) { if (e.target === lb) close(); });

    document.addEventListener("keydown", function (e) {
      if (!lb.classList.contains("open")) return;
      if (e.key === "Escape") close();
      if (e.key === "ArrowLeft") { index--; render(); }
      if (e.key === "ArrowRight") { index++; render(); }
    });
  }

  /* ----------------------------------------------------- scroll reveal */
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var targets = document.querySelectorAll(".reveal");

  var io;
  if (reduced || !("IntersectionObserver" in window)) {
    targets.forEach(function (el) { el.classList.add("shown"); });
  } else {
    io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("shown");
        io.unobserve(entry.target);
      });
    }, { rootMargin: "0px 0px -12% 0px", threshold: 0.08 });

    targets.forEach(function (el) { io.observe(el); });

    /* stagger children so grids arrive in sequence rather than all at once */
    document.querySelectorAll(".reveal-stagger").forEach(function (group) {
      Array.prototype.forEach.call(group.children, function (child, i) {
        child.style.setProperty("--d", (i * 90) + "ms");
      });
    });
  }

  /* Reveal elements on an inactive page are display:none, so the observer
     records them as not intersecting and never fires again once the page is
     shown. Re-observing forces a fresh evaluation. */
  window.addEventListener("ctis:pageshown", function (e) {
    var page = e.detail;
    if (!page) return;

    var pending = page.querySelectorAll(".reveal:not(.shown)");
    if (reduced || !("IntersectionObserver" in window)) {
      pending.forEach(function (el) { el.classList.add("shown"); });
      return;
    }
    requestAnimationFrame(function () {
      pending.forEach(function (el) { io.unobserve(el); io.observe(el); });
    });
  });

  /* Belt and braces: hidden content is far worse than a missed animation, so
     anything still unrevealed after a few seconds is shown regardless. */
  window.setInterval(function () {
    document.querySelectorAll(".reveal:not(.shown)").forEach(function (el) {
      var r = el.getBoundingClientRect();
      if (r.width || r.height) {
        if (r.top < window.innerHeight * 1.2) el.classList.add("shown");
      }
    });
  }, 1200);

  /* ---------------------------------------------------------------- year */
  var y = document.getElementById("year");
  if (y) y.textContent = new Date().getFullYear();

  /* ---------------------------------------------------------------- form */
  /* No backend yet: the form composes a WhatsApp message so an enquiry is
     never lost. Swap this for Formspree / an API endpoint when ready. */
  var form = document.getElementById("enquiry-form");
  if (form) {
    form.addEventListener("submit", function (e) {
      e.preventDefault();

      var data = new FormData(form);
      var lines = ["New admissions enquiry — Covenant Treasures", ""];

      form.querySelectorAll("[name]").forEach(function (input) {
        var label = form.querySelector('label[for="' + input.id + '"]');
        var value = (data.get(input.name) || "").toString().trim();
        if (value && label) {
          lines.push(label.textContent.replace(/\*$/, "").trim() + ": " + value);
        }
      });

      var url = "https://wa.me/" + WHATSAPP + "?text=" + encodeURIComponent(lines.join("\n"));
      var status = document.getElementById("form-status");
      if (status) {
        status.textContent = "Opening WhatsApp so you can send this to the admissions office.";
      }
      window.open(url, "_blank", "noopener");
    });
  }


  /* -------------------------------------------------------------- router */
  var PAGES = {
    "home": { t: 'Covenant Treasures International School | Creche to College in Ibadan', d: 'A faith-based school in Ibadan, Oyo State, teaching children from creche through to college. Raising future leaders in the tradition of godliness and excellence.' },
    "about": { t: 'About Us | Covenant Treasures International School', d: 'Our mission, vision and what the school crest stands for. A Christian school in Ibadan with a multi-dimensional approach to education.' },
    "academics": { t: 'Academics | Covenant Treasures International School', d: 'The Nigerian national curriculum across three stages: creche and nursery, basic school, and college, with WAEC, NECO and JAMB preparation.' },
    "admissions": { t: 'Admissions | Covenant Treasures International School', d: 'How to apply to Covenant Treasures International School, Ibadan. Five steps, what to bring, fees and answers to common questions.' },
    "campus-life": { t: 'Campus Life | Covenant Treasures International School', d: '24-hour CCTV, reliable power, certified teachers and well-equipped classrooms, plus the clubs, sports and activities that fill the school week.' },
    "news": { t: 'News and Events | Covenant Treasures International School', d: 'Term dates, results, competitions and events at Covenant Treasures International School, Ibadan.' },
    "gallery": { t: 'Gallery | Covenant Treasures International School', d: 'Photographs of the campus, classrooms, events and sports at Covenant Treasures International School, Ibadan.' },
    "contact": { t: 'Contact Us | Covenant Treasures International School', d: 'Call, WhatsApp, email or visit Covenant Treasures International School, Off Akala Express Way, Kuola, Ibadan.' }
  };
  var DEFAULT = "home";

  function slugFromHash() {
    var h = (location.hash || "").replace(/^#\/?/, "");
    return PAGES[h] ? h : DEFAULT;
  }

  function show(slug, anchor, push) {
    var target = document.getElementById(slug);
    if (!target) return;

    document.querySelectorAll(".page").forEach(function (p) {
      p.classList.toggle("is-active", p === target);
    });

    document.querySelectorAll("[data-nav]").forEach(function (a) {
      if (a.dataset.nav === slug) { a.setAttribute("aria-current", "page"); }
      else { a.removeAttribute("aria-current"); }
    });

    var meta = PAGES[slug];
    if (meta) {
      document.title = meta.t;
      var md = document.querySelector('meta[name="description"]');
      if (md) md.setAttribute("content", meta.d);
    }

    /* close the mobile menu on navigation */
    if (nav && nav.classList.contains("open")) {
      nav.classList.remove("open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.querySelector(".nav-toggle-label").textContent = "Menu";
    }

    if (push && location.hash !== "#" + slug) {
      history.pushState(null, "", "#" + slug);
    }

    window.dispatchEvent(new CustomEvent("ctis:pageshown", { detail: target }));

    var el = anchor && document.getElementById(anchor);
    if (el) {
      el.scrollIntoView({ behavior: "smooth", block: "start" });
    } else {
      window.scrollTo(0, 0);
    }
  }

  /* intercept in-site links */
  document.addEventListener("click", function (e) {
    var a = e.target.closest('a[href^="#"]');
    if (!a) return;
    var slug = a.getAttribute("href").slice(1);
    if (!PAGES[slug]) return;          /* leave ordinary anchors alone */
    e.preventDefault();
    show(slug, a.dataset.anchor, true);
  });

  window.addEventListener("popstate", function () {
    show(slugFromHash(), null, false);
  });

  show(slugFromHash(), null, false);

})();
</script>
</body>
</html>
